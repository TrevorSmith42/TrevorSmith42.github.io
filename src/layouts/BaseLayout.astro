---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/candidate.css';
const { title, description='Research in self-organizing, scalable, and bio-inspired robotic systems exploring the co-emergence of morphology, behavior, and collective intelligence.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><meta name="theme-color" content="#111"><link rel="canonical" href={canonical}><link rel="icon" href="/images/trevor-smith.jpg" type="image/jpeg"><meta property="og:type" content="website"><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:url" content={canonical}><meta property="og:image" content={new URL('/images/og-image.jpg', Astro.site)}><title>{title}</title></head><body><a class="skip" href="#content">Skip to content</a><Header/><main id="content"><slot/></main><Footer/><script is:inline>const b=document.querySelector('.menu');const n=document.querySelector('#nav');b?.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));n?.classList.toggle('open',!o)});</script></body></html>
